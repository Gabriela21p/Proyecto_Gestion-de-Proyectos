NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://rolling:rolling@localhost:5432/rolling
MONGO_URL=mongodb://localhost:27017/rolling
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=rolling_master_key
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=rolling-api

# Catálogo curado de lugares reales con enlaces a Google Maps.
# 1 lo registra/actualiza al iniciar; 0 retira únicamente estos registros demo.
SEED_GOOGLE_PLACES_DEMO=0

# OpenStreetMap se conserva solo como capa visual del mapa.
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Fuente autoritativa de direcciones: visor oficial de Codigo Postal 4-72.
OFFICIAL_472_ENTRY_URL=https://visor.codigopostal.gov.co/RestService472/CodigoPostal/EntryOrdinary
OFFICIAL_472_TOKEN_URL=https://visor.codigopostal.gov.co/472/visor/javascript/layout.aspx
OFFICIAL_472_TIMEOUT_MS=30000
OFFICIAL_472_TOKEN_TIMEOUT_MS=10000
OFFICIAL_472_TOKEN_TTL_MS=3600000

SUPABASE_URL=
SUPABASE_ANON_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=rolling-media
