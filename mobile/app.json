{
  "expo": {
    "name": "Rolling",
    "slug": "rolling",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rollingbogota.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#f4f1ea"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
